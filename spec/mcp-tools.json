{
  "schemaVersion": "1.0",
  "tools": [
    {
      "name": "boss_health",
      "description": "健康检查",
      "operationId": "health.get",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "boss_status",
      "description": "查看登录态、会话剩余时间、风控冷却、缓存",
      "operationId": "status.get",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "boss_login_start",
      "description": "开始登录：mode=sms|qr",
      "operationId": "session.login.start",
      "inputSchema": {
        "type": "object",
        "properties": {
          "mode": {
            "default": "sms",
            "$ref": "#/$defs/LoginMode"
          },
          "phone": {
            "type": "string",
            "pattern": "^1[3-9]\\d{9}$"
          }
        },
        "$defs": {
          "LoginStartRequest": {
            "type": "object",
            "properties": {
              "mode": {
                "default": "sms",
                "$ref": "#/$defs/LoginMode"
              },
              "phone": {
                "type": "string",
                "pattern": "^1[3-9]\\d{9}$"
              }
            }
          },
          "LoginMode": {
            "type": "string",
            "enum": [
              "sms",
              "qr"
            ]
          }
        }
      }
    },
    {
      "name": "boss_login_status",
      "description": "查询登录流程状态",
      "operationId": "session.login.get",
      "inputSchema": {
        "type": "object",
        "properties": {
          "loginId": {
            "$ref": "#/$defs/LoginId"
          }
        },
        "required": [
          "loginId"
        ],
        "$defs": {
          "LoginId": {
            "type": "string",
            "pattern": "^login_[A-Za-z0-9_-]{8,64}$",
            "description": "登录流程 ID"
          }
        }
      }
    },
    {
      "name": "boss_login_captcha_solve",
      "description": "提交极验点击坐标或滑块偏移",
      "operationId": "session.login.captcha",
      "inputSchema": {
        "type": "object",
        "properties": {
          "loginId": {
            "$ref": "#/$defs/LoginId"
          },
          "kind": {
            "type": "string",
            "enum": [
              "click",
              "slider"
            ]
          },
          "points": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "x": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "y": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "required": [
                "x",
                "y"
              ]
            }
          },
          "offsetRatio": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "offsetPx": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "loginId",
          "kind"
        ],
        "$defs": {
          "LoginCaptchaInput": {
            "type": "object",
            "properties": {
              "loginId": {
                "$ref": "#/$defs/LoginId"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "click",
                  "slider"
                ]
              },
              "points": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "x": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "y": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  },
                  "required": [
                    "x",
                    "y"
                  ]
                }
              },
              "offsetRatio": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "offsetPx": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "loginId",
              "kind"
            ]
          },
          "LoginId": {
            "type": "string",
            "pattern": "^login_[A-Za-z0-9_-]{8,64}$",
            "description": "登录流程 ID"
          }
        }
      }
    },
    {
      "name": "boss_login_sms_verify",
      "description": "提交短信验证码",
      "operationId": "session.login.sms",
      "inputSchema": {
        "type": "object",
        "properties": {
          "loginId": {
            "$ref": "#/$defs/LoginId"
          },
          "code": {
            "type": "string",
            "pattern": "^\\d{4,8}$"
          }
        },
        "required": [
          "loginId",
          "code"
        ],
        "$defs": {
          "LoginId": {
            "type": "string",
            "pattern": "^login_[A-Za-z0-9_-]{8,64}$",
            "description": "登录流程 ID"
          }
        }
      }
    },
    {
      "name": "boss_login_cancel",
      "description": "取消登录流程",
      "operationId": "session.login.cancel",
      "inputSchema": {
        "type": "object",
        "properties": {
          "loginId": {
            "$ref": "#/$defs/LoginId"
          }
        },
        "required": [
          "loginId"
        ],
        "$defs": {
          "LoginId": {
            "type": "string",
            "pattern": "^login_[A-Za-z0-9_-]{8,64}$",
            "description": "登录流程 ID"
          }
        }
      }
    },
    {
      "name": "boss_search_jobs",
      "description": "按关键词 + 城市搜索岗位",
      "operationId": "search.jobs",
      "inputSchema": {
        "type": "object",
        "properties": {
          "keyword": {
            "type": "string",
            "minLength": 1
          },
          "cityCode": {
            "$ref": "#/$defs/CityCode"
          },
          "page": {
            "default": 1,
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "pageSize": {
            "default": 15,
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "pages": {
            "default": 1,
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "refresh": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": [
          "keyword"
        ],
        "$defs": {
          "SearchJobsRequest": {
            "type": "object",
            "properties": {
              "keyword": {
                "type": "string",
                "minLength": 1
              },
              "cityCode": {
                "$ref": "#/$defs/CityCode"
              },
              "page": {
                "default": 1,
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "pageSize": {
                "default": 15,
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              },
              "pages": {
                "default": 1,
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              "refresh": {
                "default": false,
                "type": "boolean"
              }
            },
            "required": [
              "keyword"
            ]
          },
          "CityCode": {
            "type": "string",
            "pattern": "^\\d{6,12}$",
            "description": "BOSS 数字城市码，如 101090100（石家庄）"
          }
        }
      }
    },
    {
      "name": "boss_list_jobs",
      "description": "按 queryId 翻页",
      "operationId": "jobs.list",
      "inputSchema": {
        "type": "object",
        "properties": {
          "queryId": {
            "type": "string"
          },
          "page": {
            "default": 1,
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "pageSize": {
            "default": 15,
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "refresh": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "string",
                "enum": [
                  "true",
                  "false"
                ]
              }
            ]
          }
        },
        "required": [
          "queryId"
        ],
        "$defs": {
          "JobsListQuery": {
            "type": "object",
            "properties": {
              "queryId": {
                "type": "string"
              },
              "page": {
                "default": 1,
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "pageSize": {
                "default": 15,
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              },
              "refresh": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "string",
                    "enum": [
                      "true",
                      "false"
                    ]
                  }
                ]
              }
            },
            "required": [
              "queryId"
            ]
          }
        }
      }
    },
    {
      "name": "boss_job_detail",
      "description": "岗位详情",
      "operationId": "jobs.detail",
      "inputSchema": {
        "type": "object",
        "properties": {
          "jobId": {
            "$ref": "#/$defs/JobId"
          },
          "securityId": {
            "type": "string"
          },
          "lid": {
            "type": "string"
          },
          "refresh": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": [
          "jobId"
        ],
        "$defs": {
          "JobId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{8,80}$",
            "description": "encryptJobId，用于 /job_detail/<id>.html"
          }
        }
      }
    },
    {
      "name": "boss_list_companies",
      "description": "岗位结果按公司去重",
      "operationId": "companies.list",
      "inputSchema": {
        "type": "object",
        "properties": {
          "queryId": {
            "type": "string"
          },
          "page": {
            "default": 1,
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "pageSize": {
            "default": 20,
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "fetchPages": {
            "default": 0,
            "type": "integer",
            "minimum": 0,
            "maximum": 5
          },
          "refresh": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "string",
                "enum": [
                  "true",
                  "false"
                ]
              }
            ]
          }
        },
        "required": [
          "queryId"
        ],
        "$defs": {
          "CompaniesListQuery": {
            "type": "object",
            "properties": {
              "queryId": {
                "type": "string"
              },
              "page": {
                "default": 1,
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "pageSize": {
                "default": 20,
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              },
              "fetchPages": {
                "default": 0,
                "type": "integer",
                "minimum": 0,
                "maximum": 5
              },
              "refresh": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "string",
                    "enum": [
                      "true",
                      "false"
                    ]
                  }
                ]
              }
            },
            "required": [
              "queryId"
            ]
          }
        }
      }
    },
    {
      "name": "boss_company_detail",
      "description": "公司详情（含工商信息）",
      "operationId": "companies.detail",
      "inputSchema": {
        "type": "object",
        "properties": {
          "companyId": {
            "$ref": "#/$defs/CompanyId"
          },
          "refresh": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": [
          "companyId"
        ],
        "$defs": {
          "CompanyId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_~.-]{4,160}$",
            "description": "encryptBrandId，用于 /gongsi/<id>.html"
          }
        }
      }
    },
    {
      "name": "boss_company_jobs",
      "description": "公司全部在招职位",
      "operationId": "companies.jobs",
      "inputSchema": {
        "type": "object",
        "properties": {
          "companyId": {
            "$ref": "#/$defs/CompanyId"
          },
          "refresh": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": [
          "companyId"
        ],
        "$defs": {
          "CompanyId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_~.-]{4,160}$",
            "description": "encryptBrandId，用于 /gongsi/<id>.html"
          }
        }
      }
    },
    {
      "name": "boss_cities",
      "description": "城市注册表",
      "operationId": "cities.list",
      "inputSchema": {
        "type": "object",
        "properties": {
          "refresh": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "string",
                "enum": [
                  "true",
                  "false"
                ]
              }
            ]
          }
        },
        "$defs": {
          "CitiesQuery": {
            "type": "object",
            "properties": {
              "refresh": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "string",
                    "enum": [
                      "true",
                      "false"
                    ]
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "name": "boss_cache_stats",
      "description": "缓存统计",
      "operationId": "cache.stats",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "boss_cache_clear",
      "description": "清缓存：scope=all|expired",
      "operationId": "cache.clear",
      "inputSchema": {
        "type": "object",
        "properties": {
          "scope": {
            "default": "all",
            "type": "string",
            "enum": [
              "all",
              "expired"
            ]
          },
          "prefix": {
            "type": "string"
          }
        },
        "$defs": {
          "CacheClearQuery": {
            "type": "object",
            "properties": {
              "scope": {
                "default": "all",
                "type": "string",
                "enum": [
                  "all",
                  "expired"
                ]
              },
              "prefix": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  ]
}
