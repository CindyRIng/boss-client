            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "offsetPx": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "loginId",
          "kind"
        ]
      },
      "LoginId": {
        "type": "string",
        "pattern": "^login_[A-Za-z0-9_-]{8,64}$",
        "description": "登录流程 ID"
      }
    }
  },
