# boss-client runtime configuration
# 所有 BOSS_* 变量均可通过 CLI/env 覆盖（优先级：CLI > env > 配置文件 > 默认值）

# 站点
BOSS_BASE_URL=https://www.zhipin.com
BOSS_LOGIN_URL=https://www.zhipin.com/web/user/?from=passport-zp&fromUrl=https%3A%2F%2Fwww.zhipin.com%2F

# 登录（短信模式需要；建议用 600 权限配置文件）
BOSS_PHONE=

# 浏览器与 profile
BOSS_PROFILE_DIR=~/.boss-client/profile
BOSS_HEADLESS=true

# 本地 REST / MCP
BOSS_API_TOKEN=change-me
BOSS_HOST=127.0.0.1
BOSS_PORT=8790
# 可选：常驻服务已运行时，让 CLI 通过 REST 调用（避免 profile 锁冲突）
# BOSS_CLIENT_URL=http://127.0.0.1:8790

# 缓存（SQLite）
BOSS_CACHE_DB=~/.boss-client/cache.db
BOSS_CACHE_QUERY_TTL=86400
BOSS_CACHE_LIST_TTL=7200
BOSS_CACHE_JOB_DETAIL_TTL=43200
BOSS_CACHE_COMPANY_TTL=604800
BOSS_CACHE_COMPANY_JOBS_TTL=7200

# 会话 / 限频
BOSS_HEARTBEAT_SEC=300
BOSS_RATE_PER_MIN=12
BOSS_MAX_PAGES=5
BOSS_PAGE_DELAY_MS=2500
BOSS_CODE37_COOLDOWN_SEC=60
BOSS_REQUEST_TIMEOUT_MS=30000
BOSS_LOGIN_TIMEOUT_SEC=600
BOSS_CITIES=101090100

# 日志
BOSS_LOG_LEVEL=info
BOSS_LOG_FILE=~/.boss-client/logs/boss.log
BOSS_LOG_MAX_BYTES=10485760
BOSS_LOG_KEEP=5
BOSS_LOG_STDOUT=true
