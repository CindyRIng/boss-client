{
  "name": "boss-client",
  "version": "0.1.0",
  "private": true,
  "description": "BOSS直聘本地只读客户端：cloak 浏览器会话保活 + 岗位/公司检索 + CLI/REST/MCP/SKILL",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "bin": {
    "boss": "./dist/main.js"
  },
  "main": "./dist/main.js",
  "exports": {
    ".": "./dist/main.js"
  },
  "files": [
    "dist",
    "spec",
    "skills"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "dev": "tsx src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen": "tsx src/generators/generate.ts",
    "gen:check": "tsx src/generators/generate.ts --check"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "cloakbrowser": "0.6.5",
    "commander": "^15.1.0",
    "playwright-core": "1.65.0",
    "pngjs": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "license": "MIT",
  "author": "CindyRIng",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CindyRIng/boss-client.git"
  },
  "homepage": "https://github.com/CindyRIng/boss-client",
  "bugs": {
    "url": "https://github.com/CindyRIng/boss-client/issues"
  },
  "keywords": [
    "boss",
    "zhipin",
    "boss直聘",
    "cloakbrowser",
    "playwright",
    "mcp",
    "cli",
    "rest",
    "recruitment",
    "lead-generation"
  ]
}
